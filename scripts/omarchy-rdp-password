#!/usr/bin/env bash
# omarchy-rdp-password — set the RDP-only password.
#
# Reads it from the terminal (twice) or from stdin with --password-stdin, writes
# it 0600 into the runtime directory, mirrors it into the config directory when
# asked (or when a mirror already exists, so autostart keeps working), and
# restarts the unit if it was running. A password that does not come back up is
# removed again: a stale secret on disk only buys failed logins.
set -euo pipefail

CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/hypr-rdp"
RUN_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hypr-rdp"
PASSWORD_FILE="$RUN_DIR/password"
STORED_FILE="$CONF_DIR/password"
UNIT="hypr-rdp.service"
MIN_LENGTH=12
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_HELPER="$SCRIPT_DIR/omarchy-rdp-config"

usage() {
  printf 'usage: omarchy-rdp-password [--store] [--password-stdin]\n' >&2
  printf '  --store           keep a copy in %s so autostart survives a logout\n' "$STORED_FILE" >&2
  printf '  --password-stdin  read the password from stdin instead of the terminal\n' >&2
}

error_json() {
  printf '{"error":"%s"}\n' "${1//\"/\\\"}"
  exit 1
}

store=false
from_stdin=false
for arg in "$@"; do
  case "$arg" in
    --store) store=true ;;
    --password-stdin) from_stdin=true ;;
    -h|--help) usage; exit 0 ;;
    *) usage; error_json "unknown option: $arg" ;;
  esac
done

read_password() {
  if [[ $from_stdin == true ]]; then
    password=""
    IFS= read -r password || true
    password="${password%$'\r'}"
    return 0
  fi
  # No flag and no terminal: there is nowhere to type, say so instead of hanging.
  [[ -t 0 ]] || error_json "no terminal to prompt on; pass --password-stdin"
  local first="" second=""
  printf 'New RDP password: ' >&2
  IFS= read -rs first || true
  printf '\nRepeat password: ' >&2
  IFS= read -rs second || true
  printf '\n' >&2
  [[ $first == "$second" ]] || error_json "passwords do not match"
  password="$first"
}

write_password_file() {
  mkdir -p "$(dirname "$1")"
  install -m 0600 /dev/null "$1"
  printf '%s\n' "$password" > "$1"
}

password=""
read_password
if (( ${#password} < MIN_LENGTH )); then
  error_json "password must be at least $MIN_LENGTH characters"
fi

was_active=false
if systemctl --user is-active "$UNIT" >/dev/null 2>&1; then was_active=true; fi

mirror=$store
if [[ -f $STORED_FILE ]]; then mirror=true; fi

write_password_file "$PASSWORD_FILE"
if [[ $mirror == true ]]; then write_password_file "$STORED_FILE"; fi

restarted=false
if [[ $was_active == true ]]; then
  restart_out=""
  if restart_out="$("$CONFIG_HELPER" restart)"; then
    restarted=true
  else
    # The running unit never accepted the new password: put it back the way it
    # was instead of leaving a secret behind that cannot log anyone in.
    rm -f "$PASSWORD_FILE" "$STORED_FILE"
    systemctl --user stop "$UNIT" >/dev/null 2>&1 || true
    printf '%s\n' "$restart_out"
    exit 1
  fi
fi

printf '{"saved":true,"stored":%s,"restarted":%s}\n' "$mirror" "$restarted"
