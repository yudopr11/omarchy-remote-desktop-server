[Unit]
Description=Native RDP server for the Omarchy Hyprland session
Documentation=https://github.com/MuNeNICK/hypr-rdp
After=graphical-session.target
PartOf=graphical-session.target
# Trigger on either nonempty password file: session-only in tmpfs
# (omarchy-rdp-password), or the stored copy used by autostart.
ConditionFileNotEmpty=|%t/hypr-rdp/password
ConditionFileNotEmpty=|%E/hypr-rdp/password

[Service]
Type=simple
ExecStart=%h/.local/bin/omarchy-rdp-server
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=graphical-session.target
